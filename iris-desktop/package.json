{
  "name": "iris-desktop",
  "version": "0.1.0",
  "description": "IrisColor Windows desktop app",
  "main": "electron/main.js",
  "author": "iris-color",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.iris.color",
    "productName": "豪赋-虹膜颜色识别",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/jre",
        "to": "jre",
        "filter": ["**/*"]
      },
      {
        "from": "resources/python",
        "to": "python",
        "filter": ["**/*"]
      },
      {
        "from": "resources/iris-api.jar",
        "to": "iris-api.jar"
      },
      {
        "from": "../iris-vision",
        "to": "iris-vision",
        "filter": [
          "**/*",
          "!.venv/**",
          "!**/__pycache__/**",
          "!debug_output/**",
          "!.pytest_cache/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "豪赋-虹膜颜色识别"
    }
  }
}
